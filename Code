-- Вспомогательная функция поиска в таблице
local function tableFind(tbl, value)
   for _, v in pairs(tbl) do
      if v == value then return true end
   end
   return false
end

-- Определение враг/союзник на основе выбранных команд
local function isEnemy(player)
   local team = player.Team
   local teamName = team and team.Name or nil
   if teamName then
      if tableFind(enemyTeams, teamName) then
         return true
      elseif tableFind(allyTeams, teamName) then
         return false
      end
   end
   return true  -- по умолчанию враг
end

-- Очистка всех ESP-объектов
local function clearESP()
   for _, data in pairs(espObjects) do
      if data.highlight then data.highlight:Destroy() end
      if data.billboard then data.billboard:Destroy() end
   end
   espObjects = {}
end

-- Обновление ESP для одного игрока (создаём или обновляем)
local function updateESPForPlayer(player)
   if not player or not player.Character then return end
   local character = player.Character
   local data = espObjects[player]

   if not espEnabled then
      if data then
         if data.highlight then data.highlight:Destroy() end
         if data.billboard then data.billboard:Destroy() end
         espObjects[player] = nil
      end
      return
   end

   if not data then
      data = {}
      espObjects[player] = data
   end

   local color = isEnemy(player) and enemyColor or allyColor

   -- Highlight
   if not data.highlight then
      local highlight = Instance.new("Highlight")
      highlight.Adornee = character
      highlight.FillColor = color
      highlight.FillTransparency = 0.5
      highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
      highlight.OutlineTransparency = 0
      highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
      highlight.Parent = character
      data.highlight = highlight
   else
      data.highlight.FillColor = color
   end

   -- Billboard (имена + здоровье)
   if showNames then
      if not data.billboard then
         local bill = Instance.new("BillboardGui")
         bill.Adornee = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart") or character
         bill.Size = UDim2.new(0, 200, 0, 50)
         bill.StudsOffset = Vector3.new(0, 2.5, 0)
         bill.AlwaysOnTop = true
         bill.Parent = character

         local label = Instance.new("TextLabel")
         label.Size = UDim2.new(1, 0, 1, 0)
         label.BackgroundTransparency = 1
         label.TextScaled = true
         label.TextColor3 = color
         label.Font = Enum.Font.GothamBold
         label.TextStrokeTransparency = 0.5
         label.Parent = bill

         data.billboard = bill
         data.label = label
      else
         data.label.TextColor3 = color
      end
      local humanoid = character:FindFirstChild("Humanoid")
      local health = humanoid and math.floor(humanoid.Health) or "?"
      data.label.Text = player.Name .. "  ❤️" .. health
   else
      if data.billboard then
         data.billboard:Destroy()
         data.billboard = nil
         data.label = nil
      end
   end
end

-- Обновить всех игроков (полная перезагрузка)
local function refreshAllESP()
   clearESP()
   if espEnabled then
      for _, player in pairs(game.Players:GetPlayers()) do
         if player ~= game.Players.LocalPlayer then
            updateESPForPlayer(player)
         end
      end
   end
end

-- Подписка на события появления/исчезновения игроков
local function setupConnections()
   for _, conn in pairs(espConnections) do conn:Disconnect() end
   espConnections = {}

   espConnections[#espConnections+1] = game.Players.PlayerAdded:Connect(function(player)
      if espEnabled then
         player.CharacterAdded:Connect(function()
            task.wait(0.3)
            updateESPForPlayer(player)
         end)
         if player.Character then
            task.wait(0.3)
            updateESPForPlayer(player)
         end
      end
   end)

   espConnections[#espConnections+1] = game.Players.PlayerRemoving:Connect(function(player)
      if espObjects[player] then
         if espObjects[player].highlight then espObjects[player].highlight:Destroy() end
         if espObjects[player].billboard then espObjects[player].billboard:Destroy() end
         espObjects[player] = nil
      end
   end)
end

-- Запуск цикла обновления 20 раз в секунду через Heartbeat
local function startUpdateLoop()
   if updateRunning then return end
   updateRunning = true

   local lastUpdate = tick()
   local interval = 0.05  -- 20 раз в секунду

   updateConnection = game:GetService("RunService").Heartbeat:Connect(function(delta)
      if not espEnabled then
         -- Если ESP выключен, можно не обновлять, но цикл продолжает работать
         return
      end
      local now = tick()
      if now - lastUpdate >= interval then
         lastUpdate = now
         -- Обновляем всех игроков
         for _, player in pairs(game.Players:GetPlayers()) do
            if player ~= game.Players.LocalPlayer and player.Character then
               updateESPForPlayer(player)
            end
         end
      end
   end)
end

-- Остановка цикла (опционально)
local function stopUpdateLoop()
   if updateConnection then
      updateConnection:Disconnect()
      updateConnection = nil
   end
   updateRunning = false
end

-- Вкл/Выкл ESP
local function toggleESP(state)
   espEnabled = state
   if espEnabled then
      refreshAllESP()
      setupConnections()
      if not updateRunning then
         startUpdateLoop()
      end
   else
      clearESP()
      for _, conn in pairs(espConnections) do conn:Disconnect() end
      espConnections = {}
      -- Остановка цикла не требуется, он продолжит работать, но проверяет espEnabled
      -- Можно оставить цикл всегда работающим, но он будет простаивать
   end
end

-- Вкл/Выкл имён
local function toggleNames(state)
   showNames = state
   if espEnabled then refreshAllESP() end
end

-- Отключение тумана
local function toggleFog(state)
   fogOff = state
   local lighting = game:GetService("Lighting")
   if fogOff then
      lighting.FogEnd = 999999
      lighting.FogStart = 0
   else
      lighting.FogEnd = 1000
      lighting.FogStart = 0
   end
end

-- Получить актуальный список команд (для дропдаунов)
local function getTeamNames()
   local names = {}
   for _, team in pairs(game:GetService("Teams"):GetTeams()) do
      table.insert(names, team.Name)
   end
   if #names == 0 then
      table.insert(names, "Нет команд")
   end
   return names
end

