debugX = true

-- Загрузка Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Window = Rayfield:CreateWindow({
   Name = "ESP & Fog Control",
   Icon = 0,
   LoadingTitle = "Загрузка...",
   LoadingSubtitle = "by YourName",
   Theme = "Default",
   DisableRayfieldPrompts = false,
   DisableBuildWarnings = false,
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "ESP_Hub",
      FileName = "Settings"
   },
   Discord = {
      Enabled = false,
      Invite = "noinvitelink",
      RememberJoins = true
   },
   KeySystem = false
})

-- Создаём вкладки с иконкой 0
local MainTab = Window:CreateTab("Главная", 0)
local TeamsTab = Window:CreateTab("Команды", 0)
local ColorsTab = Window:CreateTab("Цвета", 0)

-- Состояния
local espEnabled = false
local showNames = false
local fogOff = false

local enemyTeams = {}
local allyTeams = {}

local enemyColor = Color3.fromRGB(255, 0, 0)
local allyColor = Color3.fromRGB(0, 255, 0)

-- Хранилище ESP
local espObjects = {}
local espConnections = {}

local function tableFind(tbl, value)
   for _, v in pairs(tbl) do
      if v == value then return true end
   end
   return false
end

local function isEnemy(player)
   local team = player.Team
   local teamName = team and team.Name or nil
   if teamName then
      if tableFind(enemyTeams, teamName) then
         return true
      elseif tableFind(allyTeams, teamName) then
         return false
      end
   end
   return true
end

local function clearESP()
   for _, data in pairs(espObjects) do
      if data.highlight then data.highlight:Destroy() end
      if data.billboard then data.billboard:Destroy() end
   end
   espObjects = {}
end

local function updateESPForPlayer(player)
   if not player or not player.Character then return end
   local character = player.Character
   local data = espObjects[player]

   if not espEnabled then
      if data then
         if data.highlight then data.highlight:Destroy() end
         if data.billboard then data.billboard:Destroy() end
         espObjects[player] = nil
      end
      return
   end

   if not data then
      data = {}
      espObjects[player] = data
   end

   local color = isEnemy(player) and enemyColor or allyColor

   if not data.highlight then
      local highlight = Instance.new("Highlight")
      highlight.Adornee = character
      highlight.FillColor = color
      highlight.FillTransparency = 0.5
      highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
      highlight.OutlineTransparency = 0
      highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
      highlight.Parent = character
      data.highlight = highlight
   else
      data.highlight.FillColor = color
   end

   if showNames then
      if not data.billboard then
         local bill = Instance.new("BillboardGui")
         bill.Adornee = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart") or character
         bill.Size = UDim2.new(0, 200, 0, 50)
         bill.StudsOffset = Vector3.new(0, 2.5, 0)
         bill.AlwaysOnTop = true
         bill.Parent = character

         local label = Instance.new("TextLabel")
         label.Size = UDim2.new(1, 0, 1, 0)
         label.BackgroundTransparency = 1
         label.TextScaled = true
         label.TextColor3 = color
         label.Font = Enum.Font.GothamBold
         label.TextStrokeTransparency = 0.5
         label.Parent = bill

         data.billboard = bill
         data.label = label
      else
         data.label.TextColor3 = color
      end
      local humanoid = character:FindFirstChild("Humanoid")
      local health = humanoid and math.floor(humanoid.Health) or "?"
      data.label.Text = player.Name .. "  ❤️" .. health
   else
      if data.billboard then
         data.billboard:Destroy()
         data.billboard = nil
         data.label = nil
      end
   end
end

local function refreshAllESP()
   clearESP()
   if espEnabled then
      for _, player in pairs(game.Players:GetPlayers()) do
         if player ~= game.Players.LocalPlayer then
            updateESPForPlayer(player)
         end
      end
   end
end

local function setupConnections()
   for _, conn in pairs(espConnections) do conn:Disconnect() end
   espConnections = {}

   espConnections[#espConnections+1] = game.Players.PlayerAdded:Connect(function(player)
      if espEnabled then
         player.CharacterAdded:Connect(function()
            wait(0.3)
            updateESPForPlayer(player)
         end)
         if player.Character then
            wait(0.3)
            updateESPForPlayer(player)
         end
      end
   end)

   espConnections[#espConnections+1] = game.Players.PlayerRemoving:Connect(function(player)
      if espObjects[player] then
         if espObjects[player].highlight then espObjects[player].highlight:Destroy() end
         if espObjects[player].billboard then espObjects[player].billboard:Destroy() end
         espObjects[player] = nil
      end
   end)
end

local function startUpdateLoop()
   spawn(function()
      while wait(0.05) do
         if espEnabled then
            for _, player in pairs(game.Players:GetPlayers()) do
               if player ~= game.Players.LocalPlayer and player.Character then
                  updateESPForPlayer(player)
               end
            end
         end
      end
   end)
end

-- ========== UI ==========

-- Главная вкладка
MainTab:CreateSection("Основные настройки")

MainTab:CreateToggle({
   Name = "Включить ESP",
   CurrentValue = false,
   Callback = function(value)
      espEnabled = value
      if espEnabled then
         refreshAllESP()
         setupConnections()
      else
         clearESP()
         for _, conn in pairs(espConnections) do conn:Disconnect() end
         espConnections = {}
      end
   end
})

MainTab:CreateToggle({
   Name = "Показывать имена и здоровье",
   CurrentValue = false,
   Callback = function(value)
      showNames = value
      if espEnabled then refreshAllESP() end
   end
})

MainTab:CreateToggle({
   Name = "Отключить туман",
   CurrentValue = false,
   Callback = function(value)
      fogOff = value
      local lighting = game:GetService("Lighting")
      if fogOff then
         lighting.FogEnd = 999999
         lighting.FogStart = 0
      else
         lighting.FogEnd = 1000
         lighting.FogStart = 0
      end
   end
})

MainTab:CreateButton({
   Name = "Обновить ESP",
   Callback = function()
      if espEnabled then refreshAllESP() end
   end
})

-- Вкладка "Команды"
TeamsTab:CreateSection("Укажите команды через запятую")

TeamsTab:CreateTextBox({
   Name = "Команды-враги",
   PlaceholderText = "например: Красные, Синие",
   CurrentValue = "",
   Callback = function(text)
      enemyTeams = {}
      for word in string.gmatch(text, "[^,]+") do
         local trimmed = word:gsub("^%s*(.-)%s*$", "%1")
         if trimmed ~= "" then
            table.insert(enemyTeams, trimmed)
         end
      end
      if espEnabled then refreshAllESP() end
   end
})

TeamsTab:CreateTextBox({
   Name = "Команды-союзники",
   PlaceholderText = "например: Зелёные, Жёлтые",
   CurrentValue = "",
   Callback = function(text)
      allyTeams = {}
      for word in string.gmatch(text, "[^,]+") do
         local trimmed = word:gsub("^%s*(.-)%s*$", "%1")
         if trimmed ~= "" then
            table.insert(allyTeams, trimmed)
         end
      end
      if espEnabled then refreshAllESP() end
   end
})

TeamsTab:CreateParagraph({
   Title = "Подсказка",
   Content = "Вводите названия команд через запятую. Регистр важен! Пример: Красные, Синие"
})

-- Вкладка "Цвета"
ColorsTab:CreateSection("Настройка цветов")

ColorsTab:CreateColorPicker({
   Name = "Цвет врагов",
   Color = enemyColor,
   Callback = function(color)
      enemyColor = color
      if espEnabled then refreshAllESP() end
   end
})

ColorsTab:CreateColorPicker({
   Name = "Цвет союзников",
   Color = allyColor,
   Callback = function(color)
      allyColor = color
      if espEnabled then refreshAllESP() end
   end
})

-- Загрузка сохранённой конфигурации
Rayfield:LoadConfiguration()

-- Применяем сохранённые состояния после загрузки
spawn(function()
   wait(0.5)
   if espEnabled then
      refreshAllESP()
      setupConnections()
   end
end)

-- Запуск цикла обновления (20 раз в секунду)
startUpdateLoop()

print("ESP Hub загружен! (без ключа)")
