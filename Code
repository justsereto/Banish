-- ==================== ESP РЕНДЕРИНГ ====================

local function renderESP()
    if not espEnabled then return end
    
    local showBox = guiCheckBoxGetSelected(chkBox)
    local showLine = guiCheckBoxGetSelected(chkLine)
    local showName = guiCheckBoxGetSelected(chkName)
    local showHealth = guiCheckBoxGetSelected(chkHealth)
    
    local r, g, b = espColor.r, espColor.g, espColor.b
    local boxSize = guiScrollBarGetScrollPosition(sizeSlider) / 100 + 0.5
    
    local localPlayer = getLocalPlayer()
    if not localPlayer then return end
    
    local localX, localY, localZ = getElementPosition(localPlayer)
    
    for _, player in ipairs(getElementsByType("player")) do
        if player ~= localPlayer then
            local x, y, z = getElementPosition(player)
            if not x then break end
            
            local dist = getDistanceBetweenPoints3D(localX, localY, localZ, x, y, z)
            if dist > 300 then break end
            
            local sx, sy, visible = getScreenFromWorldPosition(x, y, z + 0.8)
            if sx and sy and visible then
                local size = boxSize * (50 / math.max(dist, 1) * 10)
                size = math.min(size, 200)
                
                if showBox then
                    dxDrawRectangle(sx - size/2, sy - size, size, size * 2, tocolor(r, g, b, 150))
                    dxDrawRectangle(sx - size/2, sy - size, size, 2, tocolor(r, g, b, 255))
                    dxDrawRectangle(sx - size/2, sy + size, size, 2, tocolor(r, g, b, 255))
                    dxDrawRectangle(sx - size/2, sy - size, 2, size * 2, tocolor(r, g, b, 255))
                    dxDrawRectangle(sx + size/2 - 2, sy - size, 2, size * 2, tocolor(r, g, b, 255))
                end
                
                if showLine then
                    local centerX, centerY = screenW/2, screenH/2
                    dxDrawLine(centerX, centerY, sx, sy, tocolor(r, g, b, 100), 2)
                end
                
                if showName then
                    local name = getPlayerName(player)
                    -- Убираем HEX теги из имени (ИСПРАВЛЕНО)
                    name = name:gsub("#%x%x%x%x%x%x", "")
                    dxDrawText(name, sx - 50, sy - size - 25, sx + 50, sy - size - 5, 
                        tocolor(255, 255, 255, 200), 0.6, "default-bold", "center", "bottom")
                end
                
                if showHealth then
                    local health = getElementHealth(player)
                    local healthPercent = math.min(health / 100, 1)
                    local healthColor = tocolor(255 - healthPercent * 255, healthPercent * 255, 0, 200)
                    
                    dxDrawRectangle(sx - size/2, sy + size + 5, size * healthPercent, 4, healthColor)
                    dxDrawRectangle(sx - size/2, sy + size + 5, size, 1, tocolor(0, 0, 0, 100))
                end
            end
        end
    end
end

addEventHandler("onClientRender", root, renderESP)

-- ==================== ОЧИСТКА ====================

addEventHandler("onClientResourceStop", resourceRoot, function()
    if fogRemoved then
        setWeather(-1)
        resetFarClipDistance()
        resetFogDistance()
    end
    removeEventHandler("onClientRender", root, renderESP)
    showCursor(false)
end)

