-- Variables
local ESPEnabled = false
local TeamCheck = false
local BoxESP = false
local TracerESP = false
local NameESP = false
local HealthBar = false
local DistanceESP = false

local ESPObjects = {}
local NoFogEnabled = false

-- No Fog Function
local function ToggleNoFog(state)
    NoFogEnabled = state
    if state then
        game:GetService("Lighting").FogEnd = 999999
        game:GetService("Lighting").FogStart = 0
        game:GetService("Lighting").Fog = false
        game:GetService("Lighting").FogMode = Enum.FogMode.None
    else
        game:GetService("Lighting").FogEnd = 1000
        game:GetService("Lighting").FogStart = 0
        game:GetService("Lighting").Fog = true
        game:GetService("Lighting").FogMode = Enum.FogMode.Linear
    end
end

-- ESP Drawing Functions
local function CreateESP(player)
    if not player or not player.Character or not player.Character:FindFirstChild("Humanoid") then return end
    
    local character = player.Character
    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
    
    if not rootPart then return end
    
    -- Create ESP Parts
    local espFolder = Instance.new("Folder")
    espFolder.Name = "ESP_" .. player.Name
    espFolder.Parent = character
    
    -- Box ESP
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "Box"
    box.Size = Vector3.new(3, 5, 1)
    box.Adornee = rootPart
    box.ZIndex = 0
    box.AlwaysOnTop = true
    box.Transparency = 0.5
    box.Color3 = player.TeamColor and player.TeamColor.Color or Color3.new(1, 1, 1)
    box.Parent = espFolder
    
    -- Tracer
    local tracer = Instance.new("LineHandleAdornment")
    tracer.Name = "Tracer"
    tracer.Thickness = 1
    tracer.ZIndex = 0
    tracer.AlwaysOnTop = true
    tracer.Color3 = player.TeamColor and player.TeamColor.Color or Color3.new(1, 1, 1)
    tracer.Parent = espFolder
    
    -- Name Label (BillboardGui)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "NameLabel"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.Adornee = rootPart
    billboard.AlwaysOnTop = true
    billboard.Parent = espFolder
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "Text"
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextScaled = true
    nameLabel.TextColor3 = player.TeamColor and player.TeamColor.Color or Color3.new(1, 1, 1)
    nameLabel.TextStrokeTransparency = 0.5
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = billboard
    
    -- Health Bar
    local healthBillboard = Instance.new("BillboardGui")
    healthBillboard.Name = "HealthBar"
    healthBillboard.Size = UDim2.new(0, 100, 0, 10)
    healthBillboard.Adornee = rootPart
    healthBillboard.AlwaysOnTop = true
    healthBillboard.Parent = espFolder
    
    local healthBar = Instance.new("Frame")
    healthBar.Name = "Bar"
    healthBar.Size = UDim2.new(1, 0, 1, 0)
    healthBar.BackgroundColor3 = Color3.new(0, 1, 0)
    healthBar.BorderSizePixel = 0
    healthBar.Parent = healthBillboard
    
    local healthBg = Instance.new("Frame")
    healthBg.Name = "Background"
    healthBg.Size = UDim2.new(1, 0, 1, 0)
    healthBg.BackgroundColor3 = Color3.new(0.3, 0.3, 0.3)
    healthBg.BorderSizePixel = 0
    healthBg.Parent = healthBillboard
    
    -- Store ESP objects
    table.insert(ESPObjects, {
        Player = player,
        Folder = espFolder,
        Box = box,
        Tracer = tracer,
        Billboard = billboard,
        NameLabel = nameLabel,
        HealthBillboard = healthBillboard,
        HealthBar = healthBar,
        HealthBg = healthBg
    })
    
    -- Update loop
    spawn(function()
        while ESPEnabled and player and player.Character and humanoid and humanoid.Health > 0 do
            local root = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Torso")
            if not root then break end
            
            -- Update Tracer
            local camera = game.Workspace.CurrentCamera
            local vector, onScreen = camera:WorldToViewportPoint(root.Position)
            
            if ESPEnabled then
                -- Update Tracer position
                local tracerLine = tracer
                if tracerLine then
                    tracerLine.From = root.Position
                    tracerLine.To = camera.CFrame.Position
                end
                
                -- Update Health
                if HealthBar and humanoid then
                    local healthPercent = humanoid.Health / humanoid.MaxHealth
                    healthBar.Size = UDim2.new(healthPercent, 0, 1, 0)
                    
                    -- Color based on health
                    if healthPercent > 0.5 then
                        healthBar.BackgroundColor3 = Color3.new(0, 1, 0)
                    elseif healthPercent > 0.25 then
                        healthBar.BackgroundColor3 = Color3.new(1, 1, 0)
                    else
                        healthBar.BackgroundColor3 = Color3.new(1, 0, 0)
                    end
                end
                
                -- Update Name with Distance
                if DistanceESP and onScreen then
                    local distance = math.floor((root.Position - camera.CFrame.Position).Magnitude)
                    nameLabel.Text = player.Name .. " [" .. distance .. "m]"
                elseif NameESP then
                    nameLabel.Text = player.Name
                end
                
                -- Team Check
                if TeamCheck and game.Players.LocalPlayer and game.Players.LocalPlayer.Team == player.Team then
                    box.Color3 = Color3.new(0, 1, 0)
                    tracer.Color3 = Color3.new(0, 1, 0)
                    nameLabel.TextColor3 = Color3.new(0, 1, 0)
                else
                    box.Color3 = player.TeamColor and player.TeamColor.Color or Color3.new(1, 0, 0)
                    tracer.Color3 = player.TeamColor and player.TeamColor.Color or Color3.new(1, 0, 0)
                    nameLabel.TextColor3 = player.TeamColor and player.TeamColor.Color or Color3.new(1, 0, 0)
                end
            end
            
            task.wait(0.1)
        end
        
        -- Cleanup if player dies or ESP disabled
        if ESPObjects then
            for i, obj in pairs(ESPObjects) do
                if obj.Player == player then
                    if obj.Folder then obj.Folder:Destroy() end
                    table.remove(ESPObjects, i)
                    break
                end
            end
        end
    end)
end

-- Remove ESP for specific player
local function RemoveESP(player)
    for i, obj in pairs(ESPObjects) do
        if obj.Player == player then
            if obj.Folder then obj.Folder:Destroy() end
            table.remove(ESPObjects, i)
            break
        end
    end
end

-- Toggle ESP
local function ToggleESP(state)
    ESPEnabled = state
    
    if state then
        -- ESP for all players
        for _, player in pairs(game.Players:GetPlayers()) do
            if player ~= game.Players.LocalPlayer then
                CreateESP(player)
            end
        end
        
        -- Connect for new players
        game.Players.PlayerAdded:Connect(function(player)
            if ESPEnabled and player ~= game.Players.LocalPlayer then
                CreateESP(player)
            end
        end)
        
        -- Remove when player leaves
        game.Players.PlayerRemoving:Connect(function(player)
            RemoveESP(player)
        end)
    else
        -- Remove all ESP
        for _, obj in pairs(ESPObjects) do
            if obj.Folder then obj.Folder:Destroy() end
        end
        ESPObjects = {}
    end
end

-- Commands Function
local function ExecuteCommand(command)
    local cmd = string.lower(command)
    
    if cmd == "esp on" then
        ToggleESP(true)
        Rayfield:Notify({Title = "ESP", Content = "ESP Enabled!", Duration = 2})
    elseif cmd == "esp off" then
        ToggleESP(false)
        Rayfield:Notify({Title = "ESP", Content = "ESP Disabled!", Duration = 2})
    elseif cmd == "nofog on" then
        ToggleNoFog(true)
        Rayfield:Notify({Title = "No Fog", Content = "No Fog Enabled!", Duration = 2})
    elseif cmd == "nofog off" then
        ToggleNoFog(false)
        Rayfield:Notify({Title = "No Fog", Content = "No Fog Disabled!", Duration = 2})
    elseif cmd == "help" then
        Rayfield:Notify({Title = "Commands", Content = "esp on/off, nofog on/off, help", Duration = 5})
    else
        Rayfield:Notify({Title = "Error", Content = "Unknown command! Type 'help'", Duration = 3})
    end
end

