-- ======== VISUALS TAB ========
local VisualsSection = VisualsTab:CreateSection("ESP")
local ESPToggle = VisualsTab:CreateToggle({
   Name = "ESP Boxes",
   CurrentValue = false,
   Flag = "ESP",
   Callback = function(Value)
      getgenv().ESPEnabled = Value
      if Value then
         spawn(function()
            while getgenv().ESPEnabled do
               pcall(function()
                  local Players = game:GetService("Players")
                  local LocalPlayer = Players.LocalPlayer
                  for _, v in pairs(Players:GetPlayers()) do
                     if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
                        local head = v.Character:FindFirstChild("Head")
                        if head then
                           local pos, onScreen = workspace.CurrentCamera:WorldToScreenPoint(head.Position)
                           if onScreen then
                              -- Simple box drawing (use Drawing library)
                              local box = Drawing.new("Square")
                              box.Visible = true
                              box.Color = Color3.fromRGB(255, 0, 0)
                              box.Thickness = 2
                              box.Size = Vector2.new(50, 100)
                              box.Position = Vector2.new(pos.X - 25, pos.Y - 50)
                              -- Store in table to clean up
                              if not getgenv().ESPObjects then getgenv().ESPObjects = {} end
                              table.insert(getgenv().ESPObjects, box)
                           end
                        end
                     end
                  end
               end)
               wait(0.1)
            end
         end)
      else
         -- Clean up drawings
         if getgenv().ESPObjects then
            for _, obj in pairs(getgenv().ESPObjects) do
               obj:Remove()
            end
            getgenv().ESPObjects = {}
         end
      end
   end
})

