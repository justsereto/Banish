local toggleBtn = guiCreateButton(
    screenW * 0.85, 
    screenH * 0.80, 
    screenW * 0.12, 
    screenH * 0.07,
    "🔍 ESP", 
    false
)
guiSetFont(toggleBtn, "default-bold-small")
guiSetProperty(toggleBtn, "NormalTextColour", "FF00FF00")
guiSetVisible(toggleBtn, true)

-- Перетаскивание кнопки
local dragging = false
local dragOffX, dragOffY = 0, 0

addEventHandler("onClientGUIClick", toggleBtn, function(button, state)
    if button == "left" and state == "down" then
        if isMobile then
            dragging = true
            local x, y = guiGetPosition(toggleBtn, false)
            local mx, my = getCursorPosition()
            dragOffX = mx * screenW - x
            dragOffY = my * screenH - y
        end
    elseif state == "up" and not dragging then
        -- Открываем меню только если не перетаскивали
        local visible = guiGetVisible(gui)
        guiSetVisible(gui, not visible)
        showCursor(not visible)
    end
end, false)

-- Обработчик перетаскивания
addEventHandler("onClientMouseMove", root, function(_, _, x, y)
    if dragging then
        local newX = x - dragOffX
        local newY = y - dragOffY
        newX = math.max(0, math.min(screenW - screenW * 0.12, newX))
        newY = math.max(0, math.min(screenH - screenH * 0.07, newY))
        guiSetPosition(toggleBtn, newX, newY, false)
    end
end)

-- Сброс перетаскивания при отпускании кнопки мыши
addEventHandler("onClientMouseUp", root, function()
    dragging = false
end)

-- ==================== ПЕРЕМЕННЫЕ ====================

local espEnabled = false
local fogRemoved = false
local espColor = {r = 0, g = 255, b = 0}

-- ==================== ФУНКЦИИ ====================

-- Конвертация HEX в RGB (ИСПРАВЛЕНО)
local function hexToRgb(hex)
    if not hex then return 0, 255, 0 end
    hex = hex:gsub("#", "")
    if #hex == 6 then
        local r = tonumber("0x"..hex:sub(1,2)) or 0
        local g = tonumber("0x"..hex:sub(3,4)) or 255
        local b = tonumber("0x"..hex:sub(5,6)) or 0
        return r, g, b
    end
    return 0, 255, 0
end

-- Удаление тумана
local function toggleFog(remove)
    if remove then
        setWeather(0)
        setFarClipDistance(5000)
        setFogDistance(5000, 5000)
        fogRemoved = true
        guiLabelSetText(lblStatus, "✅ Туман удален")
        guiLabelSetColor(lblStatus, 0, 255, 0)
    else
        setWeather(-1)
        resetFarClipDistance()
        resetFogDistance()
        fogRemoved = false
        guiLabelSetText(lblStatus, "🔄 Туман восстановлен")
        guiLabelSetColor(lblStatus, 255, 255, 0)
    end
end

-- Применение настроек
local function applySettings()
    local fogState = guiCheckBoxGetSelected(chkFog)
    toggleFog(fogState)
    
    local distValue = guiScrollBarGetScrollPosition(distSlider)
    local distance = 100 + (distValue * 50)
    setFogDistance(distance, distance)
    setFarClipDistance(distance)
    
    local hex = guiGetText(colorEdit)
    espColor.r, espColor.g, espColor.b = hexToRgb(hex)
    
    espEnabled = guiCheckBoxGetSelected(chkESP)
    if espEnabled then
        guiLabelSetText(lblStatus, "✅ ESP активирован")
        guiLabelSetColor(lblStatus, 0, 255, 0)
    else
        guiLabelSetText(lblStatus, "⛔ ESP отключен")
        guiLabelSetColor(lblStatus, 255, 255, 0)
    end
end

-- Быстрая смена цвета
local function setColor(hex)
    guiSetText(colorEdit, hex)
    applySettings()
end

