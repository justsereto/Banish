local enemyColor = Color3.fromRGB(255, 0, 0)   -- красный
local allyColor = Color3.fromRGB(0, 255, 0)     -- зелёный

-- Хранилище ESP объектов
local espObjects = {}
local espConnections = {}

-- Функция определения враг/союзник
local function isEnemy(player)
   local localPlayer = game.Players.LocalPlayer
   if player == localPlayer then return false end
   local localTeam = localPlayer.Team
   local playerTeam = player.Team
   -- Если у кого-то нет команды, считаем врагом (можно настроить)
   if not localTeam or not playerTeam then return true end
   return localTeam ~= playerTeam
end

-- Очистка ESP для всех
local function clearESP()
   for _, data in pairs(espObjects) do
      if data.highlight then data.highlight:Destroy() end
      if data.billboard then data.billboard:Destroy() end
   end
   espObjects = {}
end

-- Обновление ESP для одного игрока
local function updateESPForPlayer(player)
   if not player or not player.Character then return end
   local character = player.Character
   local data = espObjects[player]

   if not espEnabled then
      if data then
         if data.highlight then data.highlight:Destroy() end
         if data.billboard then data.billboard:Destroy() end
         espObjects[player] = nil
      end
      return
   end

   if not data then
      data = {}
      espObjects[player] = data
   end

   -- Определяем цвет
   local color = isEnemy(player) and enemyColor or allyColor

   -- Highlight
   if not data.highlight then
      local highlight = Instance.new("Highlight")
      highlight.Adornee = character
      highlight.FillColor = color
      highlight.FillTransparency = 0.5
      highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
      highlight.OutlineTransparency = 0
      highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
      highlight.Parent = character
      data.highlight = highlight
   else
      -- Обновляем цвет, если изменился
      data.highlight.FillColor = color
   end

   -- Billboard (имена)
   if showNames then
      if not data.billboard then
         local bill = Instance.new("BillboardGui")
         bill.Adornee = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart") or character
         bill.Size = UDim2.new(0, 200, 0, 50)
         bill.StudsOffset = Vector3.new(0, 2.5, 0)
         bill.AlwaysOnTop = true
         bill.Parent = character

         local label = Instance.new("TextLabel")
         label.Size = UDim2.new(1, 0, 1, 0)
         label.BackgroundTransparency = 1
         label.TextScaled = true
         label.TextColor3 = color  -- цвет текста совпадает с цветом подсветки
         label.Font = Enum.Font.GothamBold
         label.TextStrokeTransparency = 0.5
         label.Parent = bill

         data.billboard = bill
         data.label = label
      else
         -- обновляем цвет текста
         data.label.TextColor3 = color
      end
      -- Обновляем текст (имя + здоровье)
      local humanoid = character:FindFirstChild("Humanoid")
      local health = humanoid and math.floor(humanoid.Health) or "?"
      local name = player.Name
      data.label.Text = name .. "  ❤️" .. health
   else
      if data.billboard then
         data.billboard:Destroy()
         data.billboard = nil
         data.label = nil
      end
   end
end

-- Обновление всех игроков
local function refreshAllESP()
   clearESP()
   if espEnabled then
      for _, player in pairs(game.Players:GetPlayers()) do
         if player ~= game.Players.LocalPlayer then
            updateESPForPlayer(player)
         end
      end
   end
end

-- Настройка событий
local function setupConnections()
   for _, conn in pairs(espConnections) do
      conn:Disconnect()
   end
   espConnections = {}

   espConnections[#espConnections+1] = game.Players.PlayerAdded:Connect(function(player)
      if espEnabled then
         player.CharacterAdded:Connect(function(char)
            wait(0.5)
            updateESPForPlayer(player)
         end)
         if player.Character then
            wait(0.5)
            updateESPForPlayer(player)
         end
      end
   end)

   espConnections[#espConnections+1] = game.Players.PlayerRemoving:Connect(function(player)
      if espObjects[player] then
         if espObjects[player].highlight then espObjects[player].highlight:Destroy() end
         if espObjects[player].billboard then espObjects[player].billboard:Destroy() end
         espObjects[player] = nil
      end
   end)

   -- Также реагируем на смену команды (можно переподключать, но проще обновлять по таймеру)
end

-- Таймер обновления
local function startUpdateLoop()
   spawn(function()
      while wait(2) do
         if espEnabled then
            for _, player in pairs(game.Players:GetPlayers()) do
               if player ~= game.Players.LocalPlayer and player.Character then
                  updateESPForPlayer(player)
               end
            end
         end
      end
   end)
end

-- Вкл/Выкл ESP
local function toggleESP(state)
   espEnabled = state
   if espEnabled then
      refreshAllESP()
      setupConnections()
   else
      clearESP()
      for _, conn in pairs(espConnections) do
         conn:Disconnect()
      end
      espConnections = {}
   end
end

-- Вкл/Выкл имён
local function toggleNames(state)
   showNames = state
   if espEnabled then
      refreshAllESP()
   end
end

-- Отключение тумана
local function toggleFog(state)
   fogOff = state
   local lighting = game:GetService("Lighting")
   if fogOff then
      lighting.FogEnd = 999999
      lighting.FogStart = 0
   else
      lighting.FogEnd = 1000
      lighting.FogStart = 0
   end
end

