--[[
    UI с ESP и удалением тумана для MTA:SA
]]

-- Инициализация
local gui = guiCreateWindow(0.3, 0.3, 0.4, 0.5, "ESP + Fog Remover", true)
guiWindowSetSizable(gui, false)

-- Вкладки
local tabPanel = guiCreateTabPanel(0.02, 0.05, 0.96, 0.90, true, gui)
local tabESP = guiCreateTab("ESP", tabPanel)
local tabSettings = guiCreateTab("Настройки", tabPanel)

-- ==================== ВКЛАДКА ESP ====================
local chkESP = guiCreateCheckBox(0.05, 0.05, 0.40, 0.06, "Включить ESP", false, true, tabESP)
local chkBox = guiCreateCheckBox(0.05, 0.15, 0.40, 0.06, "Показывать Box", true, true, tabESP)
local chkLine = guiCreateCheckBox(0.05, 0.25, 0.40, 0.06, "Показывать Lines", true, true, tabESP)
local chkName = guiCreateCheckBox(0.05, 0.35, 0.40, 0.06, "Показывать имена", true, true, tabESP)
local chkHealth = guiCreateCheckBox(0.05, 0.45, 0.40, 0.06, "Показывать здоровье", true, true, tabESP)

-- Выбор цвета (исправлено)
local lblColor = guiCreateLabel(0.05, 0.55, 0.30, 0.05, "Цвет Box:", true, tabESP)
local colorEdit = guiCreateEdit(0.35, 0.55, 0.30, 0.06, "#00FF00", true, tabESP) -- HEX цвет

-- Размер
local lblSize = guiCreateLabel(0.05, 0.65, 0.30, 0.05, "Размер Box:", true, tabESP)
local sizeSlider = guiCreateScrollBar(0.35, 0.65, 0.40, 0.06, true, true, tabESP)
guiScrollBarSetScrollPosition(sizeSlider, 50)

-- ==================== ВКЛАДКА НАСТРОЙКИ ====================
local chkFog = guiCreateCheckBox(0.05, 0.05, 0.80, 0.06, "Удалить туман (Fog Remover)", false, true, tabSettings)

-- Дальность видимости (исправлено)
local lblDist = guiCreateLabel(0.05, 0.15, 0.40, 0.05, "Дальность видимости:", true, tabSettings)
local distSlider = guiCreateScrollBar(0.05, 0.22, 0.80, 0.06, true, true, tabSettings)
guiScrollBarSetScrollPosition(distSlider, 100)

-- Кнопка применения
local btnApply = guiCreateButton(0.30, 0.35, 0.40, 0.08, "Применить настройки", true, tabSettings)

-- Статус
local lblStatus = guiCreateLabel(0.05, 0.50, 0.90, 0.05, "Статус: Ожидание", true, tabSettings)
guiLabelSetColor(lblStatus, 255, 255, 0)

-- ==================== ПЕРЕМЕННЫЕ ====================
local espEnabled = false
local fogRemoved = false
local espColor = {r = 0, g = 255, b = 0}

-- ==================== ФУНКЦИИ УДАЛЕНИЯ ТУМАНА ====================

-- Функция конвертации HEX в RGB
local function hexToRgb(hex)
    hex = hex:gsub("#", "")
    if #hex == 6 then
        return tonumber("0x"..hex:sub(1,2)), 
               tonumber("0x"..hex:sub(3,4)), 
               tonumber("0x"..hex:sub(5,6))
    end
    return 0, 255, 0 -- По умолчанию зеленый
end

-- Удаление тумана (исправлено)
local function toggleFog(remove)
    if remove then
        -- MTA способ удаления тумана
        setWeather(0) -- Ясная погода
        setFarClipDistance(5000) -- Максимальная дальность
        setFogDistance(5000, 5000) -- Правильный синтаксис
        fogRemoved = true
        guiLabelSetText(lblStatus, "Статус: Туман удален ✓")
        guiLabelSetColor(lblStatus, 0, 255, 0)
    else
        setWeather(-1) -- Возвращаем стандартную
        resetFarClipDistance()
        resetFogDistance()
        fogRemoved = false
        guiLabelSetText(lblStatus, "Статус: Туман восстановлен")
        guiLabelSetColor(lblStatus, 255, 255, 0)
    end
end

-- Применение настроек
local function applySettings()
    local fogState = guiCheckBoxGetSelected(chkFog)
    toggleFog(fogState)
    
    -- Дальность
    local distValue = guiScrollBarGetScrollPosition(distSlider)
    local distance = 100 + (distValue * 50)
    setFogDistance(distance, distance)
    setFarClipDistance(distance)
    
    -- Цвет из HEX
    local hex = guiGetText(colorEdit)
    espColor.r, espColor.g, espColor.b = hexToRgb(hex)
    
    -- ESP
    espEnabled = guiCheckBoxGetSelected(chkESP)
    if espEnabled then
        guiLabelSetText(lblStatus, "Статус: ESP активирован ✓")
        guiLabelSetColor(lblStatus, 0, 255, 0)
    else
        guiLabelSetText(lblStatus, "Статус: ESP отключен")
        guiLabelSetColor(lblStatus, 255, 255, 0)
    end
end

-- ==================== ОБРАБОТЧИКИ ====================

-- Кнопка применения
addEventHandler("onClientGUIClick", btnApply, applySettings, false)

-- Автоприменение при изменении тумана
addEventHandler("onClientGUIClick", chkFog, function()
    applySettings()
end, false)

-- Автоприменение при изменении цвета (по Enter)
addEventHandler("onClientGUIChanged", colorEdit, function()
    applySettings()
end, false)

-- ==================== ESP РЕНДЕРИНГ ====================

local function renderESP()
    if not espEnabled then return end
    
    local showBox = guiCheckBoxGetSelected(chkBox)
    local showLine = guiCheckBoxGetSelected(chkLine)
    local showName = guiCheckBoxGetSelected(chkName)
    local showHealth = guiCheckBoxGetSelected(chkHealth)
    
    local r, g, b = espColor.r, espColor.g, espColor.b
    local boxSize = guiScrollBarGetScrollPosition(sizeSlider) / 100 + 0.5
    
    local localPlayer = getLocalPlayer()
    if not localPlayer then return end
    
    local localX, localY, localZ = getElementPosition(localPlayer)
    
    for _, player in ipairs(getElementsByType("player")) do
        if player ~= localPlayer then
            local x, y, z = getElementPosition(player)
            if not x then break end
            
            local dist = getDistanceBetweenPoints3D(localX, localY, localZ, x, y, z)
            if dist > 300 then break end
            
            -- Исправлено: правильный вызов
            local sx, sy, visible = getScreenFromWorldPosition(x, y, z + 0.8)
            if sx and sy and visible then
                local size = boxSize * (50 / math.max(dist, 1) * 10)
                size = math.min(size, 200) -- Ограничение
                
                -- BOX
                if showBox then
                    dxDrawRectangle(sx - size/2, sy - size, size, size * 2, tocolor(r, g, b, 150))
                    dxDrawRectangle(sx - size/2, sy - size, size, 2, tocolor(r, g, b, 255))
                    dxDrawRectangle(sx - size/2, sy + size, size, 2, tocolor(r, g, b, 255))
                    dxDrawRectangle(sx - size/2, sy - size, 2, size * 2, tocolor(r, g, b, 255))
                    dxDrawRectangle(sx + size/2 - 2, sy - size, 2, size * 2, tocolor(r, g, b, 255))
                end
                
                -- LINE
                if showLine then
                    local centerX, centerY = guiGetScreenSize()
                    dxDrawLine(centerX/2, centerY/2, sx, sy, tocolor(r, g, b, 100), 2)
                end
                
                -- NAME
                if showName then
                    local name = getPlayerName(player):gsub("#%x%x%x%x%x%x", "")
                    dxDrawText(name, sx - 50, sy - size - 25, sx + 50, sy - size - 5, 
                        tocolor(255, 255, 255, 200), 0.6, "default-bold", "center", "bottom")
                end
                
                -- HEALTH
                if showHealth then
                    local health = getElementHealth(player)
                    local healthPercent = math.min(health / 100, 1)
                    local healthColor = tocolor(255 - healthPercent * 255, healthPercent * 255, 0, 200)
                    
                    dxDrawRectangle(sx - size/2, sy + size + 5, size * healthPercent, 4, healthColor)
                    dxDrawRectangle(sx - size/2, sy + size + 5, size, 1, tocolor(0, 0, 0, 100))
                end
            end
        end
    end
end

-- Рендеринг
addEventHandler("onClientRender", root, renderESP)

-- ==================== ОЧИСТКА ====================

addEventHandler("onClientResourceStop", resourceRoot, function()
    if fogRemoved then
        setWeather(-1)
        resetFarClipDistance()
        resetFogDistance()
    end
    removeEventHandler("onClientRender", root, renderESP)
end)

