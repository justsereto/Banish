-- ---------- Misc: Auto Heal ----------
-- Пример: ищем аптечку в инвентаре, используем, если здоровье ниже порога
RunService.Heartbeat:Connect(function()
    if Settings.AutoHeal and Humanoid then
        if Humanoid.Health < Settings.HealThreshold then
            -- Ищем в бэкпаке инструмент с названием "Medkit" или "Bandage"
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if backpack then
                for _, item in ipairs(backpack:GetChildren()) do
                    if item:IsA("Tool") and (item.Name:lower():find("med") or item.Name:lower():find("bandage") or item.Name:lower():find("health")) then
                        -- Используем предмет
                        item:Activate()
                        break
                    end
                end
            end
        end
    end
end)

