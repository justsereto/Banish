-- ---------- Вспомогательные функции ----------
function GetPlayers()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            table.insert(list, player)
        end
    end
    return list
end

function GetClosestPlayer(FOV)
    local closest = nil
    local shortest = FOV or math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local center = Vector2.new(mousePos.X, mousePos.Y)
    
    for _, player in ipairs(GetPlayers()) do
        local char = player.Character
        if char then
            local part = char:FindFirstChild(Settings.AimbotPart) or char:FindFirstChild("Head") or char:FindFirstChild("Torso")
            if part then
                local screenPos, onScreen = Camera:WorldToScreenPoint(part.Position)
                if onScreen then
                    local vec = Vector2.new(screenPos.X, screenPos.Y) - center
                    local dist = vec.Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest, shortest
end

function GetWeapon()
    local char = Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            return tool
        end
    end
    return nil
end

-- ---------- Функции для Aimbot ----------
local aimbotRunning = false
function AimbotLoop()
    if not Settings.AimbotEnabled then return end
    local target, dist = GetClosestPlayer(Settings.AimbotFOV)
    if target and Settings.AimbotEnabled then
        local char = target.Character
        if char then
            local part = char:FindFirstChild(Settings.AimbotPart) or char:FindFirstChild("Head") or char:FindFirstChild("Torso")
            if part then
                local targetPos = part.Position
                -- Плавное прицеливание
                local currentCFrame = Camera.CFrame
                local lookAt = CFrame.new(currentCFrame.Position, targetPos)
                local lerped = currentCFrame:Lerp(lookAt, Settings.AimbotSmoothness)
                Camera.CFrame = lerped
            end
        end
    end
end

-- Привязка кнопки для аимбота (удержание)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 and Settings.AimbotEnabled then
        aimbotRunning = true
        while aimbotRunning and Settings.AimbotEnabled do
            AimbotLoop()
            RunService.RenderStepped:Wait()
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        aimbotRunning = false
    end
end)

-- ---------- ESP (рисование) ----------
local espObjects = {}
function UpdateESP()
    if not Settings.ESPEnabled then
        -- Удаляем все ESP объекты
        for _, obj in ipairs(espObjects) do
            obj:Remove()
        end
        espObjects = {}
        return
    end
    
    -- Очищаем старые объекты
    for _, obj in ipairs(espObjects) do
        obj:Remove()
    end
    espObjects = {}
    
    for _, player in ipairs(GetPlayers()) do
        local char = player.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
            if root then
                local pos, onScreen = Camera:WorldToScreenPoint(root.Position)
                if onScreen then
                    local teamColor = player.Team and player.Team.TeamColor and player.Team.TeamColor.Color or Color3.new(1,1,1)
                    local color = Settings.ESPTeamColor and teamColor or Color3.new(0,1,0)
                    
                    -- Box ESP
                    if Settings.ESPBox then
                        local size = Vector2.new(80, 120) -- примерный размер
                        local box = Drawing.new("Square")
                        box.Visible = true
                        box.Position = Vector2.new(pos.X - size.X/2, pos.Y - size.Y/2)
                        box.Size = size
                        box.Color = color
                        box.Thickness = 2
                        box.Filled = false
                        table.insert(espObjects, box)
                    end
                    
                    -- Name ESP
                    if Settings.ESPName then
                        local nameText = Drawing.new("Text")
                        nameText.Visible = true
                        nameText.Position = Vector2.new(pos.X, pos.Y - 80)
                        nameText.Text = player.Name
                        nameText.Color = color
                        nameText.Size = 16
                        nameText.Center = true
                        nameText.Outline = true
                        nameText.OutlineColor = Color3.new(0,0,0)
                        table.insert(espObjects, nameText)
                    end
                    
                    -- Health ESP
                    if Settings.ESPHealth then
                        local health = char.Humanoid and char.Humanoid.Health or 100
                        local healthBar = Drawing.new("Line")
                        healthBar.Visible = true
                        healthBar.From = Vector2.new(pos.X - 30, pos.Y + 30)
                        healthBar.To = Vector2.new(pos.X - 30 + health/2, pos.Y + 30)
                        healthBar.Color = Color3.new(1 - health/100, health/100, 0)
                        healthBar.Thickness = 6
                        table.insert(espObjects, healthBar)
                    end
                    
                    -- Distance ESP
                    if Settings.ESPDistance then
                        local dist = (Camera.CFrame.Position - root.Position).Magnitude
                        local distText = Drawing.new("Text")
                        distText.Visible = true
                        distText.Position = Vector2.new(pos.X, pos.Y + 40)
                        distText.Text = string.format("%.0fm", dist)
                        distText.Color = Color3.new(1,1,1)
                        distText.Size = 14
                        distText.Center = true
                        distText.Outline = true
                        distText.OutlineColor = Color3.new(0,0,0)
                        table.insert(espObjects, distText)
                    end
                end
            end
        end
    end
end

